# Copy to terraform.tfvars and adjust. All values below are optional -
# capacity names come from ../platform.json (written by bootstrap).

# Second pass, after setting the DataEngineering workspaces to case insensitive:
# workspace_collation_confirmed = true

# Use an existing capacity instead of the generated one:
# capacity_name_overrides = { Dev = "mytrialcapacity" }

# workspace_name_prefix = "Contoso-"

